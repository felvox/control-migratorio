PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=control_migratorio
PGUSER=postgres
PGPASSWORD=postgres

# Ruta absoluta al storage del proyecto en el servidor.
STORAGE_PATH=/opt/control-migratorio/storage

# Carpeta de salida para respaldos.
BACKUP_DIR=/opt/control-migratorio/backups

# Elimina respaldos mas antiguos que estos dias.
RETENTION_DAYS=15
