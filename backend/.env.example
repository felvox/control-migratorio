DATABASE_URL="postgresql://postgres:postgres@localhost:5432/control_migratorio?schema=public"
JWT_SECRET="change_me_with_a_long_random_secret_in_prod"
JWT_EXPIRES_IN="8h"
PORT=3000
STORAGE_ROOT="../storage"
MAX_UPLOAD_SIZE_MB=10
# Opcional. En producción usar el dominio del frontend.
# Si queda vacío, permite cualquier origen (útil para desarrollo local).
CORS_ORIGIN=""
# Lista opcional de IPs autorizadas para consumir la API, separadas por coma.
# Ejemplo: "181.12.34.56,190.98.12.44"
ALLOWED_IPS=""
