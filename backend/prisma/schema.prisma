generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  OPERADOR
  CONSULTA
  AUDITOR
  CARABINEROS
  PDI
}

enum Jaf {
  TARAPACA
  ANTOFAGASTA
  ARICA_PARINACOTA
}

enum TipoControl {
  INGRESO
  EGRESO
}

enum TipoPersona {
  PRINCIPAL
  ACOMPANANTE
  MENOR
}

enum EstadoCaso {
  PENDIENTE
  DERIVADO_CARABINEROS
  DERIVADO_PDI
  CERRADO
}

enum TipoEvidencia {
  FOTO_PERSONA
  DOCUMENTO_IDENTIDAD
  ADJUNTO_GENERAL
}

enum InstitucionDerivacion {
  NINGUNA
  CARABINEROS
  PDI
}

enum MotivoCierreSesion {
  LOGOUT
  INACTIVIDAD
  EXPIRACION
  FORZADO
}

enum FeedbackPrioridad {
  BAJA
  MEDIA
  ALTA
}

enum FeedbackEstado {
  PENDIENTE
  REVISADO
}

enum FeedbackDireccion {
  A_MASTER
  A_OPERATIVOS
}

model Usuario {
  id                        String              @id @default(uuid())
  run                       String              @unique
  email                     String?             @unique
  nombreCompleto            String
  passwordHash              String
  rol                       Role
  esMaster                  Boolean             @default(false)
  jaf                       Jaf?
  activo                    Boolean             @default(true)
  eliminadoAt               DateTime?
  creadoAt                  DateTime            @default(now())
  actualizadoAt             DateTime            @updatedAt
  casosCreados              Caso[]              @relation("CasoCreadoPor")
  casosActualizados         Caso[]              @relation("CasoActualizadoPor")
  personasCreadas           Persona[]           @relation("PersonaCreadaPor")
  evidenciasCreadas         Evidencia[]         @relation("EvidenciaCreadaPor")
  documentosGenerados       DocumentoGenerado[] @relation("DocumentoGeneradoPor")
  auditorias                Auditoria[]
  auditoriasSeguridadRevisadas Auditoria[]      @relation("AuditoriaSeguridadRevisadaPor")
  sesiones                  SesionAcceso[]
  feedbackEnviados          Feedback[]          @relation("FeedbackCreadoPor")
  feedbackRevisados         Feedback[]          @relation("FeedbackRevisadoPor")

  @@index([rol])
  @@index([esMaster])
  @@index([activo])
  @@index([jaf])
}

model Caso {
  id                       String                @id @default(uuid())
  codigo                   String                @unique
  jaf                      Jaf                   @default(TARAPACA)
  tipoControl              TipoControl
  fechaHoraProcedimiento   DateTime
  lugar                    String
  coordenadas              String?
  fechaIngreso             DateTime?
  documentado              Boolean               @default(false)
  estadoSalud              String?
  observaciones            String?
  vieneAcompanado          Boolean               @default(false)
  existenMenores           Boolean               @default(false)
  institucionDerivacion    InstitucionDerivacion @default(NINGUNA)
  estado                   EstadoCaso            @default(PENDIENTE)
  pdiOrdenJudicialVigente  Boolean?
  pdiSituacionMigratoria   String?
  pdiReconducible          Boolean?
  pdiResultado             String?
  pdiObservacionesCierre   String?
  creadoPorId              String
  actualizadoPorId         String?
  creadoAt                 DateTime              @default(now())
  actualizadoAt            DateTime              @updatedAt
  eliminadoAt              DateTime?
  creadoPor                Usuario               @relation("CasoCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoPor           Usuario?              @relation("CasoActualizadoPor", fields: [actualizadoPorId], references: [id])
  personas                 Persona[]
  evidencias               Evidencia[]
  documentos               DocumentoGenerado[]
  auditorias               Auditoria[]           @relation("CasoAuditoria")

  @@index([fechaHoraProcedimiento])
  @@index([estado])
  @@index([lugar])
  @@index([jaf])
}

model Persona {
  id              String      @id @default(uuid())
  casoId          String
  tipoPersona     TipoPersona
  nombres         String
  apellidos       String
  nacionalidad    String
  fechaNacimiento DateTime
  edad            Int
  lugarNacimiento String?
  numeroDocumento String
  profesionOficio String?
  estadoCivil     String?
  domicilio       String?
  correo          String?
  telefono        String?
  creadoPorId     String?
  creadoAt        DateTime    @default(now())
  actualizadoAt   DateTime    @updatedAt
  caso            Caso        @relation(fields: [casoId], references: [id])
  creadoPor       Usuario?    @relation("PersonaCreadaPor", fields: [creadoPorId], references: [id])
  evidencias      Evidencia[]

  @@index([casoId])
  @@index([numeroDocumento])
  @@index([nombres, apellidos])
}

model Evidencia {
  id            String        @id @default(uuid())
  casoId        String
  personaId     String?
  tipoEvidencia TipoEvidencia
  nombreOriginal String
  nombreGuardado String
  rutaArchivo    String
  mimeType       String
  tamanoBytes    Int
  creadoPorId    String
  creadoAt       DateTime     @default(now())
  caso           Caso         @relation(fields: [casoId], references: [id])
  persona        Persona?     @relation(fields: [personaId], references: [id])
  creadoPor      Usuario      @relation("EvidenciaCreadaPor", fields: [creadoPorId], references: [id])

  @@index([casoId])
  @@index([personaId])
  @@index([tipoEvidencia])
}

model DocumentoGenerado {
  id             String   @id @default(uuid())
  casoId         String
  tipo           String
  nombreOriginal String
  nombreGuardado String
  rutaArchivo    String
  mimeType       String
  tamanoBytes    Int
  creadoPorId    String
  creadoAt       DateTime @default(now())
  caso           Caso     @relation(fields: [casoId], references: [id])
  creadoPor      Usuario  @relation("DocumentoGeneradoPor", fields: [creadoPorId], references: [id])

  @@index([casoId])
  @@index([tipo])
}

model Auditoria {
  id          String   @id @default(uuid())
  usuarioId   String?
  casoId      String?
  seguridadRevisadoPorId String?
  accion      String
  entidad     String
  entidadId   String?
  descripcion String?
  metadata    Json?
  fechaHora   DateTime @default(now())
  seguridadRevisadoAt DateTime?
  ip          String?
  userAgent   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
  caso        Caso?    @relation("CasoAuditoria", fields: [casoId], references: [id])
  seguridadRevisadoPor Usuario? @relation("AuditoriaSeguridadRevisadaPor", fields: [seguridadRevisadoPorId], references: [id])

  @@index([fechaHora])
  @@index([accion])
  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([seguridadRevisadoAt])
  @@index([seguridadRevisadoPorId])
}

model SesionAcceso {
  id           String    @id @default(uuid())
  usuarioId    String
  inicioSesion DateTime  @default(now())
  ultimaActividadAt DateTime @default(now())
  cierreSesion DateTime?
  motivoCierre MotivoCierreSesion?
  ip           String?
  userAgent    String?
  usuario      Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([inicioSesion])
  @@index([ultimaActividadAt])
  @@index([cierreSesion])
  @@index([usuarioId])
}

model Feedback {
  id            String            @id @default(uuid())
  asunto        String
  mensaje       String
  prioridad     FeedbackPrioridad @default(MEDIA)
  estado        FeedbackEstado    @default(PENDIENTE)
  direccion     FeedbackDireccion @default(A_MASTER)
  jaf           Jaf
  jafDestino    Jaf?
  usuarioId     String
  revisadoPorId String?
  creadoAt      DateTime          @default(now())
  revisadoAt    DateTime?
  usuario       Usuario           @relation("FeedbackCreadoPor", fields: [usuarioId], references: [id])
  revisadoPor   Usuario?          @relation("FeedbackRevisadoPor", fields: [revisadoPorId], references: [id])

  @@index([estado])
  @@index([jaf])
  @@index([creadoAt])
  @@index([usuarioId])
}
